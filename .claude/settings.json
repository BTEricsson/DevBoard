{
  "permissions": {
    "allow": [
      "Bash(timeout 3 node server.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-plan.js",
            "statusMessage": "Checking for PLAN.md..."
          }
        ]
      }
    ]
  }
}
